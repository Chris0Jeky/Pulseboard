{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(cd:*)",
      "Bash(npm ci:*)",
      "Bash(npm install:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npm start:*)",
      "Bash(npx vitest:*)",
      "Bash(npx vue-tsc:*)",
      "Bash(npx vite:*)",
      "Bash(node --test:*)",
      "Bash(node --version:*)",
      "Bash(node src/local.mjs:*)",
      "Bash(python -m venv:*)",
      "Bash(python -m pytest:*)",
      "Bash(venv/Scripts/python:*)",
      "Bash(./venv/Scripts/python:*)",
      "Bash(../venv/Scripts/python:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(mypy:*)",
      "Bash(black:*)",
      "Bash(curl http://localhost:*)",
      "Bash(curl http://127.0.0.1:*)",
      "Bash(netstat:*)",
      "Bash(taskkill:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.db)",
      "Read(./**/*.sqlite)",
      "Read(./**/*.sqlite3)"
    ]
  },
  "worktree": {
    "symlinkDirectories": [
      "frontend/pulseboard-web/node_modules"
    ]
  }
}
