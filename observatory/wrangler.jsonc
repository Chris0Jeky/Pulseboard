{
  "name": "pulseboard-observatory",
  "main": "src/entry.mjs",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "vars": { "COLLECT_ENABLED": "false", "WATCH_ENABLED": "false" },
  // Each tick runs probeAll() over the fixed targets in src/projects.mjs and then maintain() (14-day event
  // and budget retention, 30-day probe history). COLLECT_ENABLED gates browser admission only, never probing.
  "triggers": { "crons": ["*/15 * * * *"] },
  "d1_databases": [{ "binding": "DB", "database_name": "pulseboard-observatory", "database_id": "9dfae806-0948-4fa8-9cd6-ab14fa48728e" }],
  // Same-account Workers cannot be fetched through their public hostname from a Worker (error 1042); src/projects.mjs
  // names these bindings on the two probes that need them.
  "services": [
    { "binding": "COMMITATLAS", "service": "commit-atlas" },
    { "binding": "ALIBI", "service": "alibi-after-hours-preview" }
  ],
  "env": {
    // Disposable admission gate from docs/ROLLOUT.md: collection on, no cron, its own scratch database.
    // Deploy with `npx wrangler deploy --env preview`; delete the Worker with `npx wrangler delete --env preview` afterwards.
    "preview": {
      "name": "pulseboard-observatory-preview",
      "vars": { "COLLECT_ENABLED": "true" },
      "triggers": { "crons": [] },
      "d1_databases": [{ "binding": "DB", "database_name": "pulseboard-observatory-scratch", "database_id": "75c78861-b347-4b03-8a02-7cd9a9e13bb0" }]
    }
  }
}
